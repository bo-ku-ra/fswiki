<!-- for D2 -->
<script type="module">
// D2ライブラリをインポート
import { D2 } from 'https://esm.sh/@terrastruct/d2@nightly/es2022/d2.mjs';

/**
 * 指定された単一の要素にD2図をレンダリングします。
 * @param {Element} el - レンダリング対象のDOM要素
 */
async function renderD2Element(el) {
  const src = (el.textContent || '').trim();
  if (!src || el.dataset.d2Rendered) {
    return;
  }

  try {
    // レンダリング前にコンテナを準備
    el.innerHTML = 'D2 Rendering...';
    el.style.display = 'flex'; // 先に表示スタイルを適用

    // ブラウザがDOMの表示変更を反映するのを待つ
    await new Promise(resolve => setTimeout(resolve, 0));

    // D2インスタンスを都度生成
    const d2 = new D2();
    const diagram = await d2.compile(src);
    
    // innerHTML を使ってSVG文字列を書き込む
    el.innerHTML = await d2.render(diagram.diagram, { pad: 5, scale: 1 });
    
    // レンダリング成功のマークを付ける
    el.dataset.d2Rendered = '1';

  } catch (error) {
    console.error(`D2 Rendering Error in #${el.id}:`, error);
    el.innerText = `Failed to render D2 diagram.\n\nError: ${error.message}`;
    el.style.color = 'red';
    el.style.whiteSpace = 'pre-wrap';
  }
}

/**
 * ページ内のすべてのD2図を順番にレンダリングします。
 */
async function renderAllSequentially() {
  const elements = document.querySelectorAll('[id^="d2source_"]');
  for (const el of elements) {
    await renderD2Element(el);
  }
}

// DOMの読み込み状態に応じて、レンダリング処理を実行
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', renderAllSequentially);
} else {
  renderAllSequentially();
}
</script>
